# Supabase project settings → API. Only these two values are used in the client.
# Copy this file to .env and fill in your own project's values.
# Never put the service_role key or SMTP credentials here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
